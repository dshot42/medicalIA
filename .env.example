# MedConnect AI fonctionne intégralement en local par défaut.
MEDCONNECT_DATA_DIR=data
MEDCONNECT_UPLOAD_DIR=uploads
MEDCONNECT_DATABASE_PATH=data/medconnect.db
MEDCONNECT_QDRANT_PATH=data/qdrant
MEDCONNECT_QDRANT_COLLECTION=patient_medical_records
MEDCONNECT_KNOWLEDGE_COLLECTION=medical_knowledge_base
MEDCONNECT_KNOWLEDGE_BASE_PATH=data/knowledge/medical_knowledge.json
MEDCONNECT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEDCONNECT_MAX_FILE_SIZE_MB=10

# LLM GGUF local par defaut : aucun contenu patient n'est envoye sur le reseau.
# Valeurs: gguf, disabled, ollama, openai_compatible
MEDCONNECT_LLM_PROVIDER=gguf
MEDCONNECT_GGUF_MODEL_PATH=C:/Users/come/Desktop/ia-llm/phi3/ia_llm/ressources/models/Qwen3.5-9B-Q6_K.gguf
MEDCONNECT_GGUF_CONTEXT_SIZE=65536
MEDCONNECT_GGUF_THREADS=8
MEDCONNECT_GGUF_GPU_LAYERS=-1
MEDCONNECT_GGUF_MAX_TOKENS=512
MEDCONNECT_GGUF_TEMPERATURE=0.1
MEDCONNECT_LLM_MODEL=llama3.1:8b
MEDCONNECT_OLLAMA_BASE_URL=http://localhost:11434
MEDCONNECT_OPENAI_BASE_URL=http://localhost:1234/v1
MEDCONNECT_OPENAI_API_KEY=
MEDCONNECT_MAX_INVESTIGATION_ITERATIONS=12
MEDCONNECT_MAX_INVESTIGATION_LLM_CALLS=8
MEDCONNECT_INVESTIGATION_TIMEOUT_SECONDS=600
MEDCONNECT_INVESTIGATION_MODEL_VERSION=agentic-clinical-engine-v2
MEDCONNECT_INVESTIGATION_MODE=llm_only

# Frontend
MEDCONNECT_API_URL=http://127.0.0.1:8000

